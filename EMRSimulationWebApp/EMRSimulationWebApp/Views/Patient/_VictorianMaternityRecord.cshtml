                    { key: "labour.suturedBy", label: "Sutured by", col: "quarter" },
                    { key: "labour.perineumOther", label: "Other", col: "quarter" },
                    { key: "labour.complicationsAfterBirth", label: "Complications after birth", type: "textarea", rows: 4, col: "full" },
                    { key: "labour.signName", label: "Name", col: "quarter" },
                    { key: "labour.signSignature", label: "Signature", col: "quarter" },
                    { key: "labour.signDesignation", label: "Designation", col: "quarter" },
                    { key: "labour.signDate", label: "Date", type: "date", col: "quarter" }
                ]
            },
            {
                id: "baby",
                title: "Baby Summary",
                theme: "blue",
                fields: [
                    { key: "baby.name", label: "Name of baby", col: "half" },
                    { key: "baby.bornAtDate", label: "Born at", type: "date", col: "quarter" },
                    { key: "baby.bornAtTime", label: "Time", type: "time", col: "quarter" },
                    { key: "baby.status", label: "Status", type: "select", options: ["", "Alive", "Stillborn"], col: "quarter" },
                    { key: "baby.gestation", label: "Gestation (wks)", col: "quarter" },
                    { key: "baby.gender", label: "Gender", type: "select", options: ["", "M", "F"], col: "quarter" },
                    { key: "baby.bloodGroup", label: "Blood group", col: "quarter" },
                    { key: "baby.nameLabelAttachedBy", label: "Name label attached by", col: "half" },
                    { key: "baby.vitKGiven", label: "Vit K given", type: "select", options: yesNo, col: "quarter" },
                    { key: "baby.vitKTime", label: "Time", type: "time", col: "quarter" },
                    { key: "baby.hepBGiven", label: "Hep B given", type: "select", options: yesNo, col: "quarter" },
                    { key: "baby.hepBTime", label: "Time", type: "time", col: "quarter" },
                    { key: "baby.weight", label: "Weight (kg)", col: "quarter" },
                    { key: "baby.length", label: "Length (cm)", col: "quarter" },
                    { key: "baby.headCircumference", label: "Head circumference (cm)", col: "quarter" },
                    { key: "baby.establishedRespirationsAt", label: "Established respirations at", col: "quarter" },
                    { key: "baby.resuscitation", label: "Resuscitation", type: "multicheck", options: ["Suction", "O2", "Bag and mask", "IPPV", "Other"], col: "full" },
                    { type: "apgar" },
                    { key: "baby.passedUrine", label: "Passed urine", type: "select", options: yesNo, col: "quarter" },
                    { key: "baby.passedMeconium", label: "Passed meconium", type: "select", options: yesNo, col: "quarter" },
                    { type: "subhead", title: "Feeding/skin contact" },
                    { key: "baby.skinContactWithin30Min", label: "Skin contact within 30 mins", type: "select", options: yesNo, col: "quarter" },
                    { key: "baby.skinContactDuration", label: "Duration (mins)", col: "quarter" },
                    { key: "baby.firstFeedDate", label: "First feed date", type: "date", col: "quarter" },
                    { key: "baby.firstFeedTime", label: "Time", type: "time", col: "quarter" },
                    { key: "baby.feedingType", label: "Feeding type", type: "select", options: ["", "Breastfeeding fully", "Breastfeeding partially artificial", "Formula", "Expressed breast milk"], col: "half" },
                    { key: "baby.firstBreastfeedWithin30Min", label: "First breastfeed within 30 mins", type: "select", options: yesNo, col: "quarter" },
                    { key: "baby.notes", label: "Baby notes", type: "textarea", rows: 5, col: "full" },
                    { key: "baby.signName", label: "Name", col: "quarter" },
                    { key: "baby.signSignature", label: "Signature", col: "quarter" },
                    { key: "baby.signDesignation", label: "Designation", col: "quarter" },
                    { key: "baby.signDate", label: "Date", type: "date", col: "quarter" },
                    { type: "subhead", title: "Perinatal transfer" },
                    { key: "baby.transferPerson", label: "Transfer for", type: "select", options: ["", "Mother", "Baby"], col: "quarter" },
                    { key: "baby.transferStage", label: "Transfer stage", type: "select", options: ["", "During pregnancy", "Labour and birth", "Postnatal"], col: "quarter" },
                    { key: "baby.transferredFrom", label: "Transferred from", col: "half" },
                    { key: "baby.transferInternalExternal", label: "Transfer type", type: "select", options: ["", "Internal", "External"], col: "quarter" },
                    { key: "baby.transferTo", label: "Transfer to", col: "quarter" },
                    { key: "baby.accompaniedBy", label: "Accompanied by", type: "select", options: ["", "Midwife", "Doctor", "Other"], col: "quarter" },
                    { key: "baby.transferTimeInvolved", label: "Length of time involved", col: "quarter" },
                    { key: "baby.careTransferred", label: "Care transferred", type: "select", options: yesNo, col: "quarter" },
                    { key: "baby.careTransferredDate", label: "Date", type: "date", col: "quarter" },
                    { key: "baby.careTransferredTime", label: "Time", type: "time", col: "quarter" },
                    { key: "baby.postnatalTransferPlanned", label: "Postnatal transfer planned", type: "select", options: yesNo, col: "quarter" },
                    { key: "baby.postnatalTransferTo", label: "To", col: "quarter" },
                    { key: "baby.postnatalTransferDate", label: "Date", type: "date", col: "quarter" },
                    { key: "baby.postnatalTransferTime", label: "Time", type: "time", col: "quarter" }
                ]
            },
            {
                id: "home",
                title: "Going Home",
                theme: "blue",
                fields: [
                    {
                        type: "table",
                        title: "Observations/Postnatal assessments",
                        base: "home.observations",
                        rows: ["Wound healing: Caesarean/Perineum", "General wellbeing", "Postnatal feelings", "Infection", "Haemorrhoids", "Varicose veins", "Diastasis recti abdominal muscles", "Urinary/Bowel function", "Fundus", "Lochia", "Calf tenderness", "Breasts"],
                        columns: [
                            { key: "detail", label: "Details", wide: true }
                        ],
                        labelsAsRows: true
                    },
                    { key: "home.rubellaVaccinationRequired", label: "Rubella vaccination required?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.rubellaDate", label: "Date", type: "date", col: "quarter" },
                    { key: "home.rubellaTime", label: "Time", type: "time", col: "quarter" },
                    { key: "home.rhNegMother", label: "Rh neg mother?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.antiDGiven", label: "Anti D given?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.antiDDate", label: "Date", type: "date", col: "quarter" },
                    { key: "home.antiDTime", label: "Time", type: "time", col: "quarter" },
                    { type: "subhead", title: "Baby feeding and domiciliary visits" },
                    { key: "home.breastfeedingOnDischarge", label: "Breastfeeding on discharge?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.breastfeedingConcerns", label: "Concerns/issues about breastfeeding", type: "textarea", rows: 3, col: "half" },
                    { key: "home.domiciliaryVisits", label: "Domiciliary visit/s including signature and date/s", type: "textarea", rows: 8, col: "half" },
                    {
                        type: "table",
                        title: "Follow-up appointments/referrals",
                        base: "home.followups",
                        rows: 7,
                        columns: [
                            { key: "visitType", label: "Visit at home/6 week check/MCHN/other", wide: true },
                            { key: "date", label: "Date", type: "date" }
                        ]
                    },
                    { type: "subhead", title: "Discharge from hospital" },
                    { key: "home.dischargedFromHospital", label: "Discharged from hospital", type: "date", col: "quarter" },
                    { key: "home.dischargeMotherBaby", label: "Discharge for", type: "select", options: ["", "Mother", "Baby", "Mother and Baby"], col: "quarter" },
                    { key: "home.destinationAddress", label: "Destination address", type: "textarea", rows: 4, col: "half" },
                    { key: "home.totalHospitalStayDays", label: "Total hospital stay days", col: "quarter" },
                    { key: "home.totalHospitalStayHours", label: "Hours", col: "quarter" },
                    { key: "home.birthNotificationCompleted", label: "Birth notification completed?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.forwardMchn", label: "Forward MCHN", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.forwardMchnDate", label: "Date", type: "date", col: "quarter" },
                    { key: "home.dataEnteredDatabase", label: "Data entered on database?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.dataEnteredDate", label: "Date", type: "date", col: "quarter" },
                    { key: "home.letterSentGp", label: "Letter sent to GP?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.letterSentMchn", label: "Letter sent to MCHN?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.familyAllowanceFormGiven", label: "Family allowance form given?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.fafNumber", label: "FAF#", col: "quarter" },
                    { key: "home.childHealthRecordGiven", label: "Child health record given?", type: "select", options: yesNo, col: "quarter" },
                    { key: "home.signature", label: "Signature", col: "quarter" },
                    { key: "home.signatureDate", label: "Date", type: "date", col: "quarter" },
                    { key: "home.designation", label: "Designation", col: "quarter" }
                ]
            }
        ];

        function valueFor(key) {
            return vmrData[key] ?? patientDefaults[key] ?? "";
        }

        function esc(value) {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function fieldClass(field) {
            return `vmr-field ${field.col || ""}`.trim();
        }

        function renderField(field) {
            if (field.type === "subhead") {
                return `<div class="vmr-subhead">${esc(field.title)}</div>`;
            }
            if (field.type === "table") return renderTable(field);
            if (field.type === "visitTable") return renderVisitTable(field);
            if (field.type === "apgar") return renderApgar();
            if (field.type === "multicheck") return renderMultiCheck(field);

            const value = valueFor(field.key);
            let control = "";
            const rows = field.rows || 2;

            if (field.type === "textarea") {
                control = `<textarea data-vmr-field="${esc(field.key)}" rows="${rows}">${esc(value)}</textarea>`;
            } else if (field.type === "select") {
                const options = (field.options || [""]).map(option => {
                    const selected = value === option ? "selected" : "";
                    return `<option value="${esc(option)}" ${selected}>${esc(option)}</option>`;
                }).join("");
                control = `<select data-vmr-field="${esc(field.key)}">${options}</select>`;
            } else if (field.type === "checkbox") {
                const checked = value === true || value === "true" ? "checked" : "";
                control = `<label class="vmr-check"><input type="checkbox" data-vmr-field="${esc(field.key)}" ${checked}> <span>${esc(field.label)}</span></label>`;
                return `<div class="${fieldClass(field)}">${control}</div>`;
            } else {
                const type = field.type || "text";
                control = `<input type="${esc(type)}" data-vmr-field="${esc(field.key)}" value="${esc(value)}">`;
            }

            return `<div class="${fieldClass(field)}"><label>${esc(field.label)}</label>${control}</div>`;
        }

        function renderMultiCheck(field) {
            const selected = Array.isArray(valueFor(field.key)) ? valueFor(field.key) : [];
            const checks = (field.options || []).map(option => {
                const checked = selected.includes(option) ? "checked" : "";
                return `<label class="vmr-pill-check"><input type="checkbox" data-vmr-multifield="${esc(field.key)}" value="${esc(option)}" ${checked}> ${esc(option)}</label>`;
            }).join("");

            return `<div class="vmr-field full"><label>${esc(field.label)}</label><div class="vmr-check-grid">${checks}</div></div>`;
        }

        function renderTable(config) {
            const rows = Array.isArray(config.rows) ? config.rows : Array.from({ length: config.rows }, (_, index) => index + 1);
            const head = config.labelsAsRows ? `<th>${esc(config.title || "Item")}</th>` : `<th>#</th>`;
            const columns = config.columns.map(column => `<th class="${column.wide ? "wide-col" : ""}">${esc(column.label)}</th>`).join("");
            const body = rows.map((row, rowIndex) => {
                const rowLabel = config.labelsAsRows ? row : rowIndex + 1;
                const keyPart = config.labelsAsRows ? slug(row) : rowIndex + 1;
                const cells = config.columns.map(column => {
                    const key = `${config.base}.${keyPart}.${column.key}`;
                    return `<td class="${column.wide ? "wide-col" : ""}">${tableInput(key, column.type || "text")}</td>`;
                }).join("");
                return `<tr><th>${esc(rowLabel)}</th>${cells}</tr>`;
            }).join("");

            return `<div class="vmr-table-block full"><h4>${esc(config.title)}</h4><div class="table-responsive"><table class="vmr-table"><thead><tr>${head}${columns}</tr></thead><tbody>${body}</tbody></table></div></div>`;
        }

        function renderVisitTable(config) {
            const rows = [];
            for (let visit = config.start; visit <= config.end; visit++) {
                rows.push(visit);
            }
            const columns = visitColumns.map(column => `<th class="${column.wide ? "wide-col" : ""}">${esc(column.label)}</th>`).join("");
            const body = rows.map(visit => {
                const cells = visitColumns.map(column => {
                    const key = `${config.base}.${visit}.${column.key}`;
                    return `<td class="${column.wide ? "wide-col" : ""}">${tableInput(key, column.type || "text", column.options)}</td>`;
                }).join("");
                return `<tr><th>Visit ${visit}</th>${cells}</tr>`;
            }).join("");

            return `<div class="vmr-table-block full"><h4>${esc(config.title)}</h4><div class="table-responsive"><table class="vmr-table vmr-visit-table"><thead><tr><th>Visit</th>${columns}</tr></thead><tbody>${body}</tbody></table></div></div>`;
        }

        function renderTests() {
            const columns = ["Explained", "Consent by mother", "Request by", "Date", "Reviewed by", "Review date", "Comments"];
            const head = columns.map(column => `<th>${esc(column)}</th>`).join("");
            const body = testRows.map(row => {
                const [key, label, recommend] = row;
                return `<tr>
                    <th><span>${esc(label)}</span><small>${esc(recommend)}</small></th>
                    <td>${tableInput(`tests.${key}.explained`, "checkbox")}</td>
                    <td>${tableInput(`tests.${key}.consent`, "checkbox")}</td>
                    <td>${tableInput(`tests.${key}.requestBy`)}</td>
                    <td>${tableInput(`tests.${key}.date`, "date")}</td>
                    <td>${tableInput(`tests.${key}.reviewedBy`)}</td>
                    <td>${tableInput(`tests.${key}.reviewDate`, "date")}</td>
                    <td class="wide-col">${tableInput(`tests.${key}.comments`)}</td>
                </tr>`;
            }).join("");

            const additional = renderTable({
                title: "Additional tests and investigations",
                base: "tests.additional",
                rows: 6,
                columns: [
                    { key: "test", label: "Test", wide: true },
                    { key: "explained", label: "Explained" },
                    { key: "consent", label: "Consent" },
                    { key: "requestBy", label: "Request by" },
                    { key: "date", label: "Date", type: "date" },
                    { key: "reviewedBy", label: "Reviewed by" },
                    { key: "reviewDate", label: "Review date", type: "date" },
                    { key: "comments", label: "Comments", wide: true }
                ]
            });

            return `<div class="vmr-table-block full"><h4>Recommended tests</h4><div class="table-responsive"><table class="vmr-table vmr-tests-table"><thead><tr><th>Test</th>${head}</tr></thead><tbody>${body}</tbody></table></div></div>${additional}`;
        }

        function renderApgar() {
            const rows = ["Heart rate", "Respiratory effort", "Muscle tone", "Reflex response", "Colour", "Total"];
            const minutes = ["1min", "5min", "otherMin"];
            const body = rows.map(row => {
                const cells = minutes.map(minute => `<td>${tableInput(`baby.apgar.${slug(row)}.${minute}`)}</td>`).join("");
                return `<tr><th>${esc(row)}</th>${cells}</tr>`;
            }).join("");
            return `<div class="vmr-table-block half"><h4>Apgar details and score</h4><table class="vmr-table"><thead><tr><th>Score</th><th>1 min</th><th>5 min</th><th>min</th></tr></thead><tbody>${body}</tbody></table></div>`;
        }

        function tableInput(key, type = "text", options) {
            const value = valueFor(key);
            if (type === "checkbox") {
                const checked = value === true || value === "true" ? "checked" : "";
                return `<input type="checkbox" data-vmr-field="${esc(key)}" ${checked}>`;
            }
            if (type === "select") {
                const opts = (options || [""]).map(option => `<option value="${esc(option)}" ${value === option ? "selected" : ""}>${esc(option)}</option>`).join("");
                return `<select data-vmr-field="${esc(key)}">${opts}</select>`;
            }
            return `<input type="${esc(type)}" data-vmr-field="${esc(key)}" value="${esc(value)}">`;
        }

        function slug(text) {
            return String(text).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "");
        }

        function render() {
            $("#vmrTabs").html(sections.map((section, index) => `<button type="button" class="vmr-tab ${index === 0 ? "active" : ""}" data-vmr-target="${esc(section.id)}">${esc(section.title)}</button>`).join(""));

            const html = sections.map((section, index) => {
                const body = section.custom === "tests"
                    ? renderTests()
                    : section.fields.map(renderField).join("");
                return `<section class="vmr-section vmr-theme-${esc(section.theme)} ${index === 0 ? "active" : ""}" id="vmr-section-${esc(section.id)}">
                    <div class="vmr-section-title"><span>${esc(section.title)}</span></div>
                    <div class="vmr-grid">${body}</div>
                </section>`;
            }).join("");

            $("#vmrSections").html(html);
        }

        function collectData() {
            const data = {};
            $("[data-vmr-field]").each(function () {
                const key = $(this).data("vmr-field");
                if (!key) return;
                if ($(this).attr("type") === "checkbox") {
                    data[key] = $(this).is(":checked");
                } else {
                    data[key] = $(this).val();
                }
            });

            $("[data-vmr-multifield]").each(function () {
                const key = $(this).data("vmr-multifield");
                if (!data[key]) data[key] = [];
                if ($(this).is(":checked")) data[key].push($(this).val());
            });

            return data;
        }

        function showMessage(text, kind) {
            $("#vmrMessage")
                .removeClass("success error")
                .addClass(kind || "")
                .text(text);
        }

        render();

        $("#vmrTabs").on("click", ".vmr-tab", function () {
            const target = $(this).data("vmr-target");
            $(".vmr-tab").removeClass("active");
            $(this).addClass("active");
            $(".vmr-section").removeClass("active");
            $(`#vmr-section-${target}`).addClass("active");
        });

        $("#btnPrintVmr").on("click", function () {
            window.print();
        });

        $("#btnSaveVmr").on("click", function () {
            const payload = {
                LabId: parseInt($("#vmrLabId").val(), 10),
                PatientId: parseInt($("#vmrPatientId").val(), 10),
                FormDataJson: JSON.stringify(collectData()),
                SupervisorReviewNotes: $("#vmrSupervisorReviewNotes").val()
            };

            if (!payload.LabId || !payload.PatientId) {
                showMessage("Missing lab or patient context.", "error");
                return;
            }

            $("#btnSaveVmr").prop("disabled", true).text("Saving...");
            showMessage("", "");

            $.ajax({
                type: "POST",
                url: "/Patient/SaveVictorianMaternityRecord",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.success) {
                        const byLine = response.lastUpdatedBy ? ` by ${response.lastUpdatedBy} (${response.lastUpdatedRole || "user"})` : "";
                        $("#vmrSavedMeta").html(`<strong>Last saved:</strong> ${response.lastUpdatedAt || "just now"}${byLine}`);
                        if (isSupervisor) {
                            $("#vmrReviewedBy").text(response.supervisorReviewedBy || "Not reviewed");
                            $("#vmrReviewedAt").text(response.supervisorReviewedAt || "");
                        }
                        showMessage("Saved successfully.", "success");
                    } else {
                        showMessage("The record was not saved.", "error");
                    }
                },
                error: function (xhr) {
                    showMessage(xhr.responseText || "Server error while saving.", "error");
                },
                complete: function () {
                    $("#btnSaveVmr").prop("disabled", false).text("Save VMR");
                }
            });
        });
    })();
</script>
