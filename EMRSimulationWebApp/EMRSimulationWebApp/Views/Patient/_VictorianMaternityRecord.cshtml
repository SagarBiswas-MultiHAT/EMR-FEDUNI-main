@model EMRSimulationWebApp.Models.VictorianMaternityRecordViewModel
@{
    var patientName = $"{Model.Patient.FirstName} {Model.Patient.LastName}".Trim();
    var patientDob = Model.Patient.DateOfBirth?.ToString("yyyy-MM-dd") ?? "";
    var recordJson = Model.Record.FormDataJson ?? "{}";
}

<div class="vmr-shell">
    <input type="hidden" id="vmrLabId" value="@Model.Record.LabId" />
    <input type="hidden" id="vmrPatientId" value="@Model.Record.PatientId" />

    <div class="vmr-hero">
        <div>
            <div class="vmr-kicker">Victorian</div>
            <h2>Maternity Record</h2>
            <div class="vmr-subtitle">Confidential pregnancy, birth and postnatal record</div>
        </div>
        <div class="vmr-patient-label">
            <label>Woman's name</label>
            <div>@patientName</div>
            <label>UR number</label>
            <div>@Model.Patient.UriNumber</div>
        </div>
    </div>

    <div class="vmr-status-bar">
        <div><strong>Patient:</strong> @patientName</div>
        <div><strong>DOB:</strong> @patientDob</div>
        <div><strong>URI:</strong> @Model.Patient.UriNumber</div>
        <div id="vmrSavedMeta">
            <strong>Last saved:</strong>
            @(Model.Record.LastUpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Not saved yet")
            @if (!string.IsNullOrWhiteSpace(Model.Record.LastUpdatedBy))
            {
                <span> by @Model.Record.LastUpdatedBy (@Model.Record.LastUpdatedRole)</span>
            }
        </div>
    </div>

    <div class="vmr-actions">
        <button type="button" class="btn btn-primary" id="btnSaveVmr">Save VMR</button>
        <button type="button" class="btn btn-outline-dark" id="btnPrintVmr">Print</button>
        <span id="vmrMessage" class="vmr-message" aria-live="polite"></span>
    </div>

    <div id="vmrTabs" class="vmr-tabs"></div>
    <form id="vmrForm" class="vmr-form">
        <div id="vmrSections"></div>
    </form>

    <section class="vmr-section vmr-review-section">
        <div class="vmr-section-title">
            <span>Supervisor Review</span>
        </div>
        <div class="vmr-field full">
            <label for="vmrSupervisorReviewNotes">Review notes</label>
            <textarea id="vmrSupervisorReviewNotes" rows="4" @(Model.IsSupervisor ? "" : "readonly")>@Model.Record.SupervisorReviewNotes</textarea>
        </div>
        <div class="vmr-review-meta">
            Reviewed by: <strong id="vmrReviewedBy">@(Model.Record.SupervisorReviewedBy ?? "Not reviewed")</strong>
            <span id="vmrReviewedAt">@Model.Record.SupervisorReviewedAt?.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    </section>
</div>

